{
  "name": "vibewatch-cloud",
  "version": "1.0.0",
  "description": "Self-hosted quota synchronization API for VibeWatch",
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types --include-runtime false",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "npm run build && tsx --test test/*.test.ts",
    "db:local": "wrangler d1 migrations apply vibewatch --local",
    "deploy": "wrangler deploy",
    "test:server": "tsx test/serve.ts"
  },
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "@types/node": "26.6.2",
    "miniflare": "5.20260918.0-alpha",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "wrangler": "4.135.0"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
